# Copier ce fichier en `.env.local` et renseigner les valeurs.
# `.env.local` n'est jamais commite (voir .gitignore).

# --- Formulaire de contact (Resend) ---------------------------------------
# Cle d'API : https://resend.com/api-keys
# Sans elle, le formulaire affiche une erreur au visiteur plutot que de laisser
# croire que le message est parti.
RESEND_API_KEY=

# Expediteur. Doit appartenir a un domaine verifie dans Resend
# (https://resend.com/domains), par exemple : "Portfolio <contact@mondomaine.fr>"
# Tant qu'aucun domaine n'est verifie, laisser vide : le code retombe sur
# "Portfolio <onboarding@resend.dev>", le domaine de test de Resend, qui
# n'autorise l'envoi que vers l'adresse du titulaire du compte Resend.
CONTACT_FROM_EMAIL=

# Destinataire des messages du formulaire.
# Laisser vide pour utiliser l'adresse definie dans lib/content/site-config.ts.
CONTACT_TO_EMAIL=
